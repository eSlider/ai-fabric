# Gitea container runtime
USER_UID=1000
USER_GID=1000
DOCKER_UID=1000
# Host docker group GID (run: getent group docker | cut -d: -f3)
DOCKER_GID=1000

# Docker Compose project name (must match how the stack was first started)
COMPOSE_PROJECT_NAME=ai-fabric
GITEA__actions__ENABLED=true
GITEA__database__DB_TYPE=sqlite3
GITEA__database__PATH=/data/gitea/gitea.db

# Gitea identity
GITEA__server__ROOT_URL=http://localhost:3000/
GITEA__server__SSH_DOMAIN=localhost

# Actions runner
GITEA_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_REGISTRATION_TOKEN=replace-with-runner-token
GITEA_RUNNER_NAME=ai-fabric-runner
# GITEA_RUNNER_LABELS=ubuntu-latest:docker://gitea/runner-images:ubuntu-latest
CONFIG_FILE=/tmp/runner/config.yaml

# Gitea MCP service
GITEA_HOST=http://gitea:3000
GITEA_ACCESS_TOKEN=
GITEA_INSECURE=false

# Telegram bot control plane
TELEGRAM_BOT_NAME=trrrrmonexbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USERNAMES=
GITEA_BOT_BASE_URL=http://localhost:3000
GITEA_BOT_OWNER=eslider
GITEA_BOT_REPO=ai-fabric
GITEA_BOT_TOKEN=
# Per-role agent users (fallback to GITEA_BOT_TOKEN when empty)
GITEA_HANDLER_TOKEN=
GITEA_REVIEWER_TOKEN=
GITEA_ARCHITECT_TOKEN=
# HMAC secret for incoming Gitea webhooks on :8082 (REQUIRED in daemon mode;
# the issue-handler refuses to start without it)
GITEA_WEBHOOK_SECRET=

# Issue handler automation
ISSUE_BASE_BRANCH=main
ISSUE_POLL_INTERVAL_SEC=45
ISSUE_MAX_FIX_ATTEMPTS=3
ISSUE_RETRY_INTERVAL_SEC=600
ISSUE_IN_PROGRESS_TIMEOUT_SEC=3600
# Hard deadline for a single agent run (default 1800)
ISSUE_AGENT_TIMEOUT_SEC=1800
# Failed architect runs per issue before status:needs_human (default 2)
ISSUE_ARCHITECT_MAX_ATTEMPTS=2
# Developer rounds per PR to satisfy the reviewer before status:needs_human (default 3)
ISSUE_REVIEW_FIX_MAX_PER_PR=3
# Explicit agent model override; otherwise the first non-fast composer model is used
ISSUE_SMART_MODEL=
ISSUE_AGENT_BIN=agent
ISSUE_AGENT_EXTRA_ARGS=
ISSUE_HANDLER_DRY_RUN=0
ISSUE_ARCHITECT_ENABLED=1
ISSUE_ARCHITECT_MAX_CHARS=6000
CURSOR_SETTINGS_DIR=
CURSOR_CONFIG_DIR=
CURSOR_LOCAL_BIN_DIR=
CURSOR_AGENT_HOME_DIR=
CURSOR_API_KEY=
